# ── Browser (public, safe to expose) ─────────────────────────────────────────
# From Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server only (never prefix with VITE_) ────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Daily AI budget per student (units; most requests cost 1)
AI_DAILY_LIMIT=200
AI_PER_MINUTE_LIMIT=20

# Local development only: allow AI calls without Supabase sign-in.
# Ignored in production.
ALLOW_DEMO_MODE=true
