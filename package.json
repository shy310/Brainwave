{
  "name": "brainwave",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/dev.ts",
    "dev:all": "concurrently -n web,api \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "start": "tsx server/dev.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^4.22.3",
    "jose": "^6.2.15",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "mathjs": "^15.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
